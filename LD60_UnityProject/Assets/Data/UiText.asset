  <SkipHint>k__BackingField:
    _ru: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 Q, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    _en: Hold Q to skip
  <FinishLabel>k__BackingField:
    _ru: "\u0417\u0410\u0412\u0415\u0420\u0428\u0418\u0422\u042C"
    _en: FINISH
  <TheEndLabel>k__BackingField:
    _ru: "\u041A\u043E\u043D\u0435\u0446.\n\u041C\u043E\u0436\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435."
    _en: 'The End.

      You can close the application.'
  <HelpText>k__BackingField:
    _ru: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415\n\n\u041B\u041A\u041C
      \u2014 \u043D\u0430\u0432\u0435\u0441\u0442\u0438 \u0430\u043D\u0442\u0435\u043D\u043D\u0443,
      \u041B\u041A\u041C \u0435\u0449\u0451 \u0440\u0430\u0437 \u2014 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0441\u0438\u0433\u043D\u0430\u043B\n\u041F\u041A\u041C \u2014 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C
      \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435\n\u041A\u041E\u041B\u0415\u0421\u041E
      \u2014 \u0448\u0438\u0440\u0438\u043D\u0430 \u0441\u0438\u0433\u043D\u0430\u043B\u0430:
      \u0448\u0438\u0440\u0435 \u2014 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435
      \u0438 \u043F\u043B\u043E\u0442\u043D\u0435\u0435, \u0443\u0436\u0435 \u2014
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0438 \u0440\u0435\u0436\u0435\nV
      \u2014 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430: \u043F\u043E\u0439\u043C\u0430\u043D\u043D\u044B\u0435
      \u0433\u043E\u043B\u043E\u0441\u0430, \u041B\u041A\u041C \u043F\u043E \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0443
      \u2014 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C\n\u041F\u0420\u041E\u0411\u0415\u041B
      \u0438\u043B\u0438 \u0421\u041A\u041C \u2014 \u043F\u0430\u0443\u0437\u0430\nZ
      \u2014 \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u044F\u0437\u044B\u043A\nQ
      \u2014 \u044D\u0442\u043E \u043C\u0435\u043D\u044E\n\n\u0427\u0442\u043E\u0431\u044B
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441 \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u043C,
      \u043D\u0430\u0434\u043E \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0435\u0433\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432.\n\u0417\u0430\u0440\u044F\u0434
      \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u2014 \u0432\u043D\u0438\u0437\u0443
      \u0441\u043B\u0435\u0432\u0430, \u0434\u0430\u0442\u0430 \u2014 \u0432\u043D\u0438\u0437\u0443
      \u0441\u043F\u0440\u0430\u0432\u0430."
    _en: 'CONTROLS


      LMB - aim the antenna, LMB again - send the signal

      RMB
      - cancel aiming

      WHEEL - signal width: wider is slower and denser, narrower
      is faster and sparser

      V - the record: caught voices, LMB on a portrait
      to listen

      SPACE or MMB - pause

      Z - switch language

      Q -
      this menu


      To talk to a craft you must catch several of its signals.

      Battery
      charge is in the bottom left, the date in the bottom right.'
  <AimReadoutFormat>k__BackingField:
    _ru: "{0:0.0} \u0433\u0440\u0430\u0434   {1:0.0} \u0435\u0434/\u0441   {3} \u0442\u043E\u0447\u0435\u043A  
      {2:0.0} \u0412\u0442\n\u0414\u0435\u0440\u0436\u0430\u0442\u044C \u041B\u041A\u041C
      - \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C, \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      - \u043F\u0443\u0441\u043A. \u041F\u041A\u041C - \u043E\u0442\u043C\u0435\u043D\u0430"
    _en: '{0:0.0} deg   {1:0.0} u/s   {3} dots   {2:0.0} W

      Hold LMB for power,
      release to send. RMB cancel'
