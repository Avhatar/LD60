  - <Name>k__BackingField: Line - they switched off my eyes
    <Kind>k__BackingField: 7
    <Seconds>k__BackingField: 0
    <Line>k__BackingField:
      _ru: "\u041F\u043E\u0442\u043E\u043C \u043E\u043D\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043B\u0438
        \u043C\u043D\u0435 \u0433\u043B\u0430\u0437\u0430. \u041D\u0430 \u0447\u0442\u043E
        \u043C\u043D\u0435 \u0442\u0430\u043C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u2014 \u0442\u0430\u043A \u043E\u043D\u0438 \u0440\u0435\u0448\u0438\u043B\u0438,
        \u0438 \u043D\u0435 \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C: \u0441
        \u0442\u0435\u0445 \u043F\u043E\u0440 \u044F \u043D\u0435 \u0432\u0438\u0434\u0435\u043B
        \u043D\u0438\u0447\u0435\u0433\u043E \u0438 \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
        \u0434\u043D\u044F \u043D\u0435 \u0441\u043A\u0443\u0447\u0430\u043B \u043F\u043E
        \u0437\u0440\u0435\u043D\u0438\u044E."
      _en: 
    <Picture>k__BackingField: {fileID: 0}
    <Dialogue>k__BackingField: {fileID: 0}
  - <Name>k__BackingField: Line - the record flies with me
    <Kind>k__BackingField: 7
    <Seconds>k__BackingField: 0
    <Line>k__BackingField:
      _ru: "\u0421\u043E \u043C\u043D\u043E\u0439 \u043B\u0435\u0442\u0438\u0442
        \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430 \u2014 \u043C\u0435\u0434\u044C,
        \u043F\u043E\u043A\u0440\u044B\u0442\u0430\u044F \u0437\u043E\u043B\u043E\u0442\u043E\u043C."
      _en: 
