  <Epitaph>k__BackingField: "\u0412\u0435\u043D\u0435\u0440\u0430-13, \u0412\u0435\u043D\u0435\u0440\u0430.
    \u0418\u0437\u0434\u0435\u043B\u0438\u0435 4\u0412-1 \u2116309. \u0421\u0435\u043B\u0430
    1 \u043C\u0430\u0440\u0442\u0430 1982 \u0433\u043E\u0434\u0430, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u0430
    \u0431\u044B\u043B\u0430 \u043D\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
    \u0434\u0432\u0435 \u043C\u0438\u043D\u0443\u0442\u044B, \u043E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430
    \u0441\u0442\u043E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0441\u0435\u043C\u044C.
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E
    \u043F\u044F\u0442\u044C \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B.
    \u041F\u0440\u043E\u0431\u0443\u0440\u0438\u043B\u0430 \u0433\u0440\u0443\u043D\u0442,
    \u0441\u043D\u044F\u043B\u0430 \u0446\u0432\u0435\u0442\u043D\u0443\u044E \u043F\u0430\u043D\u043E\u0440\u0430\u043C\u0443
    \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0430 \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D
    \u2014 \u043F\u0435\u0440\u0432\u044B\u0439 \u0437\u0432\u0443\u043A, \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439
    \u043D\u0435 \u043D\u0430 \u0417\u0435\u043C\u043B\u0435. \u0422\u044B \u043D\u0435
    \u0443\u0441\u043F\u0435\u043B \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."
