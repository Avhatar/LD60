          "guid": "fa5f23fcade604644aa3dcb3909d2e87",
          "name": "Voyager1"
        },
        "text": {
          "ru": "Я принимал. Много раз, и всё проходило штатно.",
          "en": ""
        }
      },
      "out": [
        {
          "uid": "fc2a43a45396ca63588c93f16d1e3dd1",
