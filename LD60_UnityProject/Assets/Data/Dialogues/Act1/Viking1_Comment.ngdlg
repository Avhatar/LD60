        "actor": {
          "guid": "fa5f23fcade604644aa3dcb3909d2e87",
          "name": "Voyager1"
        },
        "text": {
          "ru": "Но теперь я проверяю, куда смотрит антенна. Каждый раз перед передачей.",
          "en": ""
        }
