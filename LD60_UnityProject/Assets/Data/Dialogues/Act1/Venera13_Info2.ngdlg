        "text": {
          "ru": "Температура в точке посадки около 457 градусов, давление около 89 атмосфер.",
          "en": "Temperature at the landing site about 457 degrees, pressure about 89 atmospheres."
        }
      },
      "out": [
        {
          "uid": "0a8e61f0657e401de5113c0025d468be",
          "target": "95a4b693d7c8a9292eb3597cef78f737"
