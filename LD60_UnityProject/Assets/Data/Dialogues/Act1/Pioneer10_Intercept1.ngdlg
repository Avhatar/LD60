      ],
      "type": "dlg.say",
      "data": {
        "actor": {
          "guid": "55a974de4431c804c819e0863d0af00e",
          "name": "Pioneer10"
        },
        "text": {
          "ru": "Сорок семь единиц от Солнца. По-прежнему дальше всех.",
          "en": "Forty-seven units from the Sun. Still farther out than anyone."
        }
      },
