        "text": {
          "ru": "Пионер-10, плановый сеанс. Детектор частиц — номинально. Плазменный анализатор — номинально.",
          "en": "Pioneer 10, scheduled pass. Particle detector — nominal. Plasma analyzer — nominal."
        }
      },
      "out": [
        {
          "uid": "90c59a5b4039a74f33ae8ef728cf092b",
          "target": "e22506f6f36082de4089ab9fde6493aa"
