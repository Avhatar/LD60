        0,
        140
      ],
      "type": "dlg.say",
      "data": {
        "actor": {
          "guid": "fa5f23fcade604644aa3dcb3909d2e87",
          "name": "Voyager1"
        },
        "text": {
          "ru": "У него моя антенна. Я не знал, что от нас что-то осталось в запасе.",
          "en": ""
        }
      },
      "out": [
        {
          "uid": "2623919794cc6628f4cbc3974580a22b",
          "target": "5d94f8c5107b85e18e663ff00aa87402"
        }
