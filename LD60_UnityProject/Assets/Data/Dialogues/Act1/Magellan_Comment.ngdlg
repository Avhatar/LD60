        },
        "text": {
          "ru": "Дорожка Магеллана. Он просил дописать остальное потом.",
          "en": ""
        }
      },
      "out": [
        {
          "uid": "85a560d96c2786d34689883081b1226b",
          "target": "0a947f6e7d6748ee21bf43b0e157e2a8"
        }
      ]
    },
    {
      "uid": "0a947f6e7d6748ee21bf43b0e157e2a8",
