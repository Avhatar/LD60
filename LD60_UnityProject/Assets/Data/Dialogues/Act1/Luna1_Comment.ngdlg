          "name": "Voyager1"
        },
        "text": {
          "ru": "Дорожка «Мечты». Двадцать шестой виток, четыреста пятьдесят суток каждый.",
          "en": ""
        }
      },
      "out": [
        {
          "uid": "a338b7722f5faf42c7eb1257a84a3896",
          "target": "cf01072762e629bdfc366a5cd6912c0e"
        }
      ]
    },
    {
      "uid": "cf01072762e629bdfc366a5cd6912c0e",
