        0,
        140
      ],
      "type": "dlg.say",
      "data": {
        "actor": {
          "guid": "fa5f23fcade604644aa3dcb3909d2e87",
          "name": "Voyager1"
        },
        "text": {
          "ru": "Я попробовал посчитать свои. Не получилось: я ни разу никуда не вернулся.",
          "en": ""
        }
      },
      "out": [
        {
          "uid": "de690abbea30131608e9e95041d8021e",
          "target": "56550a0a23ee0944459165831a9a54fa"
        }
      ]
