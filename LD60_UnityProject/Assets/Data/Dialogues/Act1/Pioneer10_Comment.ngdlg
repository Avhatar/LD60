        140
      ],
      "type": "dlg.say",
      "data": {
        "actor": {
          "guid": "fa5f23fcade604644aa3dcb3909d2e87",
          "name": "Voyager1"
        },
        "text": {
          "ru": "Я посчитал. Если ничего не менять — восемь лет.",
          "en": ""
        }
      },
      "out": [
        {
          "uid": "79a053eb084624a0907e382628b6ab48",
          "target": "0448e93222c75942177e7cfff6b091d2"
        }
      ]
    },
    {
      "uid": "0448e93222c75942177e7cfff6b091d2",
