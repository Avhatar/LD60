        "text": {
          "ru": "Дорожка Десятого. Он сказал, что я его догоню и не замечу.",
          "en": ""
        }
      },
      "out": [
        {
          "uid": "e7c8bd7f74a00cb68843cba5dfca92c2",
          "target": "90402ee3a9f18a424c8314a0c13c35bc"
        }
