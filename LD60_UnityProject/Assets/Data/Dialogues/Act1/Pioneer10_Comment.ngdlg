        0,
        280
      ],
      "type": "dlg.say",
      "data": {
        "actor": {
          "guid": "fa5f23fcade604644aa3dcb3909d2e87",
          "name": "Voyager1"
        },
        "text": {
          "ru": "Я ничего не буду менять. Пусть идёт как идёт.",
          "en": ""
        }
      },
